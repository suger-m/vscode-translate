{
  "name": "selection-translator",
  "displayName": "Selection Translator",
  "description": "Translate selected text with a configurable OpenAI-compatible LLM API (customizable prompt) or the MyMemory fallback, shown in a persistent sidebar panel.",
  "version": "0.1.0",
  "publisher": "suger-m",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suger-m/vscode-translate.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "selection-translator.translateSelectionToChinese",
        "title": "翻译选中内容为中文 (Translate Selection to Chinese)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "selection-translator.translateSelectionToChinese",
          "when": "editorHasSelection",
          "group": "navigation@100"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "selection-translator",
          "title": "翻译助手",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "selection-translator": [
        {
          "id": "selectionTranslator.result",
          "name": "翻译结果",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Selection Translator",
      "properties": {
        "selectionTranslator.provider": {
          "type": "string",
          "enum": [
            "auto",
            "llm",
            "mymemory"
          ],
          "enumDescriptions": [
            "已配置 LLM 时使用 LLM，否则使用 MyMemory",
            "强制使用 LLM",
            "强制使用 MyMemory"
          ],
          "default": "auto",
          "description": "翻译提供方。"
        },
        "selectionTranslator.sourceLanguage": {
          "type": "string",
          "default": "en",
          "description": "源语言。MyMemory 下使用语言代码（如 en、ja）；LLM 下作为提示词中的语言提示，可填写“自动检测”等描述。"
        },
        "selectionTranslator.contactEmail": {
          "type": "string",
          "default": "",
          "description": "可选。联系邮箱（MyMemory 的 de 参数），可提高 MyMemory 免费配额。"
        },
        "selectionTranslator.llm.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI 兼容服务的 base URL（支持 DeepSeek、Moonshot、Ollama 等）。"
        },
        "selectionTranslator.llm.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "模型名称。"
        },
        "selectionTranslator.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key。留空时从 selectionTranslator.llm.apiKeyEnvVar 指定的环境变量读取。推荐使用环境变量，避免明文写入 settings.json。"
        },
        "selectionTranslator.llm.apiKeyEnvVar": {
          "type": "string",
          "default": "OPENAI_API_KEY",
          "description": "读取 API key 的环境变量名。"
        },
        "selectionTranslator.llm.prompt": {
          "type": "string",
          "default": "你是一名专业翻译。请将下面的文本翻译成{targetLanguage}，直接输出译文，不要添加任何解释或注释。\n源语言提示：{sourceLanguage}\n\n待翻译文本：\n{text}",
          "markdownDescription": "自定义提示词模板。可用占位符：`{text}`（选中的文本，必填）、`{sourceLanguage}`（源语言提示）、`{targetLanguage}`（目标语言，固定为简体中文）。"
        },
        "selectionTranslator.llm.timeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "default": 30,
          "description": "LLM 请求超时时间（秒）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "package": "vsce package --out dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
